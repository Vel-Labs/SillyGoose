# Silly Goose Ledger Demo environment example.
# Copy to .env.local for local development. Do not commit real secrets.

# Local demo runtime
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000
DEMO_STORE_ADAPTER=local
DEMO_STORE_FILE=data/demo-store.json

# WebAuthn / Ledger Security Key demo
# For localhost, leave WEBAUTHN_RP_ID empty or set it to localhost.
# For a LAN or HTTPS demo host, use the exact registrable host without protocol.
# Production Vercel example:
# NEXT_PUBLIC_APP_ORIGIN=https://silly-goose-eight.vercel.app
# WEBAUTHN_RP_ID=silly-goose-eight.vercel.app
# WEBAUTHN_ORIGIN=https://silly-goose-eight.vercel.app
# If a custom domain is added later, replace all three production host values
# with that custom domain before registering production passkeys there.
WEBAUTHN_RP_NAME=Silly Goose Entertainment Ledger Demo
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000

# Optional Supabase persistence adapter.
# Recommended first use: server-side persistence only. Keep browser/client
# Supabase usage disabled until a read-only or Realtime surface is intentionally added.
DEMO_SUPABASE_ENABLED=false
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_SCHEMA=silly_goose_entertainment
SUPABASE_SECRET_KEY=sb_secret_replace_me
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:replace-me@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Only needed if the browser will call Supabase directly, for example Realtime spectators.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
NEXT_PUBLIC_SUPABASE_BROWSER_ENABLED=false

# Optional MiniMax readiness for the AI opponent/status surface.
LLM_PROVIDER=minimax
MINIMAX_API_KEY=replace-me
MINIMAX_API_FORMAT=anthropic
MINIMAX_BASE_URL=https://api.minimax.io/anthropic
MINIMAX_MODEL=MiniMax-M2.7
MINIMAX_MAX_TOKENS=4000
